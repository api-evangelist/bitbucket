          "name": "Get a user",
          "request": {
            "name": "Get a user",
            "description": {
              "content": "Gets the public information associated with a user account.\n\nIf the user's profile is private, `location`, `website` and\n`created_on` elements are omitted.\n\nNote that the user object returned by this operation is changing significantly, due to privacy changes.\nSee the [announcement](https://developer.atlassian.com/cloud/bitbucket/bitbucket-api-changes-gdpr/#changes-to-bitbucket-user-objects) for details.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":selected_user"
              ],
              "host": [
                "{{baseUrl}}"
              ],
