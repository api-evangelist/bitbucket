        {
          "info": {
            "name": "Get a commit application property",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/repositories/:workspace/:repo_slug/commit/:commit/properties/:app_key/:property_name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "The repository container; either the workspace slug or the UUID in curly braces."
              },
              {
                "name": "repo_slug",
                "value": "",
                "type": "path",
                "description": "The repository."
              },
              {
                "name": "commit",
                "value": "",
                "type": "path",
                "description": "The commit."
              },
              {
                "name": "app_key",
                "value": "",
                "type": "path",
                "description": "The key of the Connect app."
              },
              {
                "name": "property_name",
                "value": "",
                "type": "path",
                "description": "The name of the property."
              }
            ]
          },
          "docs": "Retrieve an [application property](/cloud/bitbucket/application-properties/) value stored against a commit."
